{
  "name": "uswds-mcp",
  "version": "0.2.0",
  "description": "Unofficial MCP server that makes AI-generated USWDS code compliant: official component markup, a USWDS class-level validator, an accessible page composer, and integration recipes.",
  "type": "module",
  "license": "MIT",
  "author": "Bibek Poudel",
  "mcpName": "io.github.bibekpdl/uswds-mcp",
  "keywords": [
    "uswds",
    "us-web-design-system",
    "u-s-web-design-system",
    "model-context-protocol",
    "mcp",
    "mcp-server",
    "government-websites",
    "federal-websites",
    "accessibility",
    "section-508",
    "design-system",
    "usa-classes",
    "html-validator",
    "accessibility-testing",
    "ai-coding",
    "claude",
    "cursor",
    "wcag"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bibekpdl/uswds-mcp.git"
  },
  "homepage": "https://github.com/bibekpdl/uswds-mcp#readme",
  "bugs": {
    "url": "https://github.com/bibekpdl/uswds-mcp/issues"
  },
  "bin": {
    "uswds-mcp": "dist/src/index.js"
  },
  "files": [
    "dist/src/**/*.js",
    "!dist/src/**/*.test.js",
    ".agents/skills/uswds/SKILL.md",
    "docs/*.md",
    "examples/**/*.json",
    "examples/**/*.md",
    "server.json",
    "README.md",
    "NOTICE.md",
    "LICENSE",
    "data/*.json",
    "!dist/src/testing.js",
    "!dist/src/eval/**"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build --silent && node dist/src/index.js",
    "ingest": "npm run build --silent && node dist/src/ingest/indexer.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "eval": "npm run build --silent && node dist/src/eval/run.js",
    "ingest:offline": "npm run build --silent && node dist/src/ingest/indexer.js --offline"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.2",
    "@uswds/uswds": "^3.14.0",
    "cheerio": "^1.0.0",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.5",
    "@types/twig": "^1.12.17",
    "axe-core": "^4.14.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.19.2",
    "twig": "^3.0.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=18"
  }
}
