{
  "name": "uswds-mcp",
  "version": "0.1.4",
  "description": "Unofficial Model Context Protocol server for working with U.S. Web Design System components, patterns, templates, tokens, and accessibility guidance.",
  "type": "module",
  "license": "MIT",
  "author": "Bibek Poudel",
  "mcpName": "io.github.bibekpdl/uswds-mcp",
  "keywords": [
    "uswds",
    "us-web-design-system",
    "u-s-web-design-system",
    "model-context-protocol",
    "mcp",
    "mcp-server",
    "government-websites",
    "federal-websites",
    "accessibility",
    "section-508",
    "design-system"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bibekpdl/uswds-mcp.git"
  },
  "homepage": "https://github.com/bibekpdl/uswds-mcp#readme",
  "bugs": {
    "url": "https://github.com/bibekpdl/uswds-mcp/issues"
  },
  "bin": {
    "uswds-mcp": "dist/src/index.js"
  },
  "files": [
    "dist/src/**/*.js",
    "!dist/src/**/*.test.js",
    "data/*.json",
    ".agents/skills/uswds/SKILL.md",
    "docs/*.md",
    "examples/**/*.json",
    "examples/**/*.md",
    "server.json",
    "README.md",
    "NOTICE.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build --silent && node dist/src/index.js",
    "ingest": "npm run build --silent && node dist/src/ingest/indexer.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.2",
    "@uswds/uswds": "^3.13.0",
    "cheerio": "^1.0.0",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=18"
  }
}
